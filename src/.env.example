# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored. Values below are local-development placeholders only.

# Account service database (PostgreSQL)
ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=admin
ACCOUNT_DB_PASSWORD=change_me_account

# Customer service database (PostgreSQL)
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=admin
CUSTOMER_DB_PASSWORD=change_me_customer

# RabbitMQ (use URL-safe characters: the password is embedded in an amqp:// URI)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_rabbit

# Admin tools
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change_me_mongo
